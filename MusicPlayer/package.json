{
  "name": "Kuromusic",
  "version": "1.1.0",
  "description": "Kuromusic is a music player built with Electron and Vue.js, designed to provide a seamless and enjoyable music listening experience. It features a sleek and intuitive interface, support for various audio formats, and integration with popular music streaming services. With Kuromusic, you can easily manage your music library, create playlists, and discover new music all in one place.",
  "main": "./out/main/index.js",
  "author": "sluq",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "chcp 65001 && electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.2.0",
    "@applemusic-like-lyrics/vue": "^0.2.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@neteasecloudmusicapienhanced/api": "^4.30.1",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vicons/ionicons5": "^0.13.0",
    "electron-store": "^11.0.2",
    "jss-preset-default": "^10.10.0",
    "music-metadata": "^11.12.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vfonts": "^0.0.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "electron": "^38.8.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.8.0",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.97.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.1",
    "vue": "^3.5.28",
    "vue-eslint-parser": "^10.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
